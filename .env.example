# HireSense Nemotron env vars (copy to .env, fill in real values)

# Nebius Token Factory (required for live Nemotron inference).
# Without this, the server runs in deterministic demo mode.
NEBIUS_API_KEY=

# Token Factory OpenAI-compatible base URL.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model routing.
# Heavy reasoning (match scoring, rationale, interview prep, critique):
NEMOTRON_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
# Fast extraction (resume parsing):
NEMOTRON_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Note: Nemotron 3 Ultra (e.g. nvidia/Nemotron-3-Ultra-550b-a55b) can be set as
# NEMOTRON_REASONING_MODEL once confirmed in the Token Factory playground.

# Tavily (optional). Powers live company/role research in the agent pipeline.
# Without this, the research step reports "skipped" honestly.
TAVILY_API_KEY=

# Server port (default 5000).
PORT=5000

# Client: API base URL for production builds (leave empty for the Vite dev proxy).
# VITE_API_URL=
